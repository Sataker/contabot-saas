# Local development uses SQLite (no database server needed).
DATABASE_URL="file:./dev.db"

# Auth.js — generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-random-32-byte-string"
AUTH_SECRET="replace-with-the-same-random-string"
NEXTAUTH_URL="http://localhost:3100"

# Google OAuth client (optional) — lets each firm connect its own Google Drive.
# Redirect URI: ${NEXTAUTH_URL}/api/v1/drive/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
